  m_Script: {fileID: 11500000, guid: 755d144cd715dea4e8cde37d58fbc5ca, type: 3}
  m_Name: AldenFinalConversation
  m_EditorClassIdentifier: Assembly-CSharp::QtsData
  speakerName: Alden
  completionKey: Viel.Npc.FinalAldenConversationComplete
  questions:
  - questionText: You made it through the last nightmare. Do you recognize this place?
    replies:
    - It feels familiar.
    - Where are we?
    correctReplyIndex: 0
    followUps:
    - The paths you crossed were pieces of a dream. You have reached its heart.
    - This is the center of the dream that carried you through every stage.
  - questionText: The creature is gone. What will you take with you when you wake?
    replies:
    - I learned to keep going.
    - I'll remember everyone.
    correctReplyIndex: 0
    followUps:
    - Then your courage is real, even if this place was a dream.
    - The people you met mattered to you. That memory will stay.
  - questionText: The way home is open now. Are you ready?
    replies:
    - I'm ready to wake up.
    - Thank you, Alden.
    correctReplyIndex: 0
    followUps:
    - Close your eyes. Morning is waiting for you.
    - You found your way, adventurer. Rest now.
