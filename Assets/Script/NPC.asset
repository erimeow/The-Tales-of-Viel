%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 755d144cd715dea4e8cde37d58fbc5ca, type: 3}
  m_Name: NPC
  m_EditorClassIdentifier: Assembly-CSharp::QtsData
  speakerName: Alden
  completionKey: Viel.Npc.AldenPracticalTutorialComplete
  questions:
  - questionText: "Welcome, traveler. I'm Alden. Before you cross into the world ahead, let me help you find your footing."
    replies:
    - "Where am I?"
    - "Can you teach me?"
    followUps:
    - "This is a safe place to learn. The path ahead is less forgiving, so let's practice before you leave."
    - "Of course. I'll guide you through each move, and you'll try it yourself before going on."
  - questionText: "First, let's see you move. Your feet will carry you farther than any sword."
    replies:
    - "How do I walk?"
    - "Can I use the arrow keys?"
    followUps:
    - "Use W, A, S, and D to move. Now take a few steps so I can see you've got it."
    - "Yes, the arrow keys work too. Try moving a short distance now; WASD will also work."
  - questionText: "Now for your attack. Practice the motion here; no one needs to get hurt."
    replies:
    - "How do I strike?"
    - "Do I need a target?"
    followUps:
    - "Press the RIGHT MOUSE BUTTON to attack. Give it one try now."
    - "Not for this lesson. Right-click once to practice your attack safely."
  - questionText: "Warrior, your shield can save your life. Let me see you raise it."
    replies:
    - "How do I guard?"
    - "When should I use my shield?"
    followUps:
    - "Hold SPACE to guard. Keep it raised for a moment so I know you're ready."
    - "Raise it when a blow is coming. Hold SPACE now and feel the stance."
  - questionText: "You've walked and practiced your attack. The path ahead is yours to explore."
    replies:
    - "Thank you, Alden."
    - "What comes next?"
    followUps:
    - "You're welcome. Follow the checkpoint flag when you're ready to travel onward."
    - "Explore at your own pace, then find the checkpoint flag to reach the next stage."
