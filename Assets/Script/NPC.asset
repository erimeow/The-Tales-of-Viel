%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 755d144cd715dea4e8cde37d58fbc5ca, type: 3}
  m_Name: NPC
  m_EditorClassIdentifier: Assembly-CSharp::QtsData
  speakerName: Alden
  completionKey: Viel.Npc.AldenTutorialComplete
  questions:
  - questionText: "Welcome, adventurer! You've awakened in a strange place. This is the beginning of your journey."
    replies:
    - "Where am I?"
    - "What should I do here?"
    followUps:
    - "You're in a peaceful starting area. This is where your journey begins before you enter the world ahead."
    - "Take your time to prepare yourself. You'll soon explore new places, gather resources, and face different challenges."
  - questionText: "Before you leave, let me teach you how to move around."
    replies:
    - "How do I move?"
    - "I'm ready to learn."
    followUps:
    - "Use the W, A, S, and D keys on your keyboard. W moves you up, A moves you left, S moves you down, and D moves you right."
    - "Excellent! Remember these keys: W to move up, A to move left, S to move down, and D to move right."
  - questionText: "Knowing how to move is important, but you'll also need to defend yourself during your journey."
    replies:
    - "How do I attack?"
    - "What button should I use?"
    followUps:
    - "Use the RIGHT MOUSE BUTTON to perform an attack. Remember, it's the right-click button, not the left-click button."
    - "Simply press the RIGHT MOUSE BUTTON to attack. Keep that in mind when facing danger."
  - questionText: "Now you know the basic controls you'll need for your journey."
    replies:
    - "Thank you for your help!"
    - "I'm ready to continue."
    followUps:
    - "You're welcome, adventurer! Stay alert and take care of yourself."
    - "That's the spirit! Prepare yourself and good luck on your journey!"
